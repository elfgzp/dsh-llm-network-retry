{
  "name": "dsh-llm-network-retry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Keep model requests alive: connection failures retry without an attempt limit (Codex-style) while real errors fail fast, and a turn killed by a process crash offers a one-click, state-checking continuation.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./policy": "./lib/policy.js",
    "./resume": "./lib/resume.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "test/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elfgzp/dsh-llm-network-retry.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "retry",
    "network",
    "resilience",
    "crash-recovery"
  ],
  "license": "MIT"
}
